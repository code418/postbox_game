{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && nyc mocha lib/test/test.index.js --reporter spec",
    "plan-route": "npm run build && node lib/scripts/plan_route.js",
    "verify-migration": "npm run build && node lib/scripts/verify_migration.js",
    "backfill-event-time": "npm run build && node lib/scripts/backfill_event_time.js"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "geolib": "^3.3.14",
    "ngeohash": "^0.6.3"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-promise": "^7.3.0",
    "firebase-functions-test": "^3.0.0",
    "mocha": "^10.0.0",
    "nyc": "^15.0.1",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7",
    "uuid": "^11.1.1",
    "ts-deepmerge": "^8.0.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    }
  },
  "private": true
}
