{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "target": "ES2020",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // Pin to this package's own @types: tsc otherwise walks UP the directory
    // tree and implicitly includes any ancestor node_modules/@types (a stray
    // half-installed ~/gits/node_modules/@types/minimatch broke the build).
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
