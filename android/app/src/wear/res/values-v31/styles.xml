<?xml version="1.0" encoding="utf-8"?>
<!-- Wear OS 4/5 (API 31+): the system SplashScreen API renders the branded
     launch. Pin its background to black so the app icon shows on black, matching
     the legacy windowBackground splash in ../drawable/launch_background.xml.
     The launcher icon (@mipmap/ic_launcher) is shown automatically — BUT the
     system splash strips the adaptive icon's white background and draws only
     the narrow postbox foreground (~20dp wide), which fails the Wear
     "Branded launch" requirement of a circular 48x48dp icon matching the
     launcher icon (Play rejection, July 2026). windowSplashScreenIconBackgroundColor
     restores a white circular disc behind the foreground, matching the
     launcher icon's look (native equivalent of Theme.SplashScreen.IconBackground). -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/white</item>
    </style>
</resources>
