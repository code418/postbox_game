<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Phone build: require touchscreen, exclude TV. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="true"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>

    <!-- health-connect:begin (permissions) — workout claims, READ-ONLY.
         Identical in src/phone and src/auto (pinned by
         test/health_connect_manifest_test.dart); never in src/main or
         src/wear. Must match the Play Console Health apps declaration. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE"/>
    <uses-permission android:name="android.permission.health.READ_EXERCISE_ROUTES"/>
    <queries>
        <package android:name="com.google.android.apps.healthdata"/>
    </queries>
    <!-- health-connect:end (permissions) -->

    <application>
        <!-- health-connect:begin (privacy) — Health Connect's "privacy
             policy" link: the rationale action (Android 13 and lower) and the
             VIEW_PERMISSION_USAGE alias (Android 14+) both open the hosted
             policy, the same one the Play listing links. -->
        <activity
            android:name="com.code418.postbox_game.health.HealthPrivacyActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <activity-alias
            android:name="com.code418.postbox_game.health.ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="com.code418.postbox_game.health.HealthPrivacyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- health-connect:end (privacy) -->
        <!-- Android Auto surface (quick-claim + stats/leaderboard panes),
             rendered by the Car App Library. Lives ONLY in the `auto` flavour,
             which is distributed OUTSIDE Google Play: Play rejected the car app
             twice under the Auto app-quality guidelines ("no meaningful
             functionality relevant to driving"), so the Play-bound `phone`
             flavour ships without it. The `wear` AAB likewise never carries the
             Car App runtime. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />
        <service
            android:name=".car.PostboxCarAppService"
            android:exported="true"
            android:foregroundServiceType="location">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <!-- Invite links (docs/marketing-plan.md, Referral). Phone-side
             flavours only: the watch never receives a shared link. Merged
             into MainActivity from src/main. The https filter is an App Link,
             verified against web/.well-known/assetlinks.json; the custom
             scheme is the invite page's "Open in the app" fallback. -->
        <activity
            android:name="com.code418.postbox_game.MainActivity"
            android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="the-postbox-game.web.app" />
                <data android:pathPrefix="/invite/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="postboxgame" android:host="invite" />
            </intent-filter>
        </activity>
    </application>
</manifest>
